    },
    "different_configmap": {
      "namespace": "reports",
      "username": "system:serviceaccount:reports:summarizer",
      "groups": [],
      "api_group": "",
      "resource": "configmaps",
      "verb": "get",
      "name": "other-settings"
    },
    "group_cluster_read": {
      "namespace": null,
      "username": "trainee",
      "groups": [
        "support"
      ],
      "api_group": "",
      "resource": "nodes",
      "verb": "get",
      "name": "lab-node"
