    "overlapping_grants": {
      "namespace": "reports",
      "username": "system:serviceaccount:reports:summarizer",
      "groups": [
        "support"
      ],
      "api_group": "",
      "resource": "pods",
      "verb": "get",
      "name": "daily"
    }
