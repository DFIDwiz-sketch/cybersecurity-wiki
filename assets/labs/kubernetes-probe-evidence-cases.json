{
  "schema": "training snapshots, not Kubernetes API objects",
  "time_unit": "seconds on one synthetic clock",
  "scope": "one fictional cluster, namespace, Service and Pod name per independent case",
  "cases": [
    {
      "id": "A",
      "note": "The same instance warms up and changes from unready to ready.",
      "before": {
        "time": 0,
        "uid": "pod-u1",
        "container": "api",
        "container_id": "runtime://a",
        "restart_count": 0,
        "started": false,
        "container_ready": false,
        "pod_ready": false,
        "previous": null
      },
      "after": {
        "time": 30,
        "uid": "pod-u1",
        "container": "api",
        "container_id": "runtime://a",
        "restart_count": 0,
        "started": true,
        "container_ready": true,
        "pod_ready": true,
        "previous": null
      },
      "endpoint": {
        "target_uid": "pod-u1",
        "ready": true,
        "serving": true,
        "terminating": false
      },
      "probe_events": [],
      "publish_not_ready": false,
      "expected": [
        "same-instance",
        "none-observed",
        "ready-endpoint"
      ]
    },
    {
      "id": "B",
      "note": "A readiness failure coincides with endpoint withdrawal from normal traffic.",
      "before": {
        "time": 0,
        "uid": "pod-u1",
        "container": "api",
        "container_id": "runtime://a",
        "restart_count": 0,
        "started": true,
        "container_ready": true,
        "pod_ready": true,
        "previous": null
      },
      "after": {
        "time": 30,
        "uid": "pod-u1",
        "container": "api",
        "container_id": "runtime://a",
        "restart_count": 0,
        "started": true,
        "container_ready": false,
        "pod_ready": false,
        "previous": null
      },
      "endpoint": {
        "target_uid": "pod-u1",
        "ready": false,
        "serving": false,
        "terminating": false
      },
      "probe_events": [
        {
          "time": 18,
          "pod_uid": "pod-u1",
          "container": "api",
          "instance_id": "runtime://a",
          "probe": "readiness",
          "action": "probe-failed"
        }
      ],
      "publish_not_ready": false,
      "expected": [
        "same-instance",
        "none-observed",
        "unready-endpoint"
      ]
    },
    {
      "id": "C",
      "note": "A kubelet stop observation matches the old API container instance and time.",
      "before": {
        "time": 0,
        "uid": "pod-u1",
        "container": "api",
        "container_id": "runtime://a",
        "restart_count": 0,
        "started": true,
        "container_ready": true,
        "pod_ready": true,
        "previous": null
      },
      "after": {
        "time": 30,
        "uid": "pod-u1",
        "container": "api",
        "container_id": "runtime://b",
        "restart_count": 1,
        "started": true,
        "container_ready": true,
        "pod_ready": true,
        "previous": {
          "container_id": "runtime://a",
          "finished_at": 19,
          "reason": "Error"
        }
      },
      "endpoint": {
        "target_uid": "pod-u1",
        "ready": true,
        "serving": true,
        "terminating": false
      },
      "probe_events": [
        {
          "time": 18,
          "pod_uid": "pod-u1",
          "container": "api",
          "instance_id": "runtime://a",
          "probe": "liveness",
          "action": "kubelet-probe-stop"
        }
      ],
      "publish_not_ready": false,
      "expected": [
        "new-container-instance",
        "liveness-stop-correlated",
        "ready-endpoint"
      ]
    },
    {
      "id": "D",
